# Yahoo Fantasy Sports API (register an app at https://developer.yahoo.com/apps/)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=

# ESPN Fantasy — extract from a logged-in browser session:
# DevTools -> Application -> Cookies -> fantasy.espn.com -> SWID and espn_s2
ESPN_SWID=
ESPN_S2=

# CBS Fantasy login
CBS_USERNAME=
CBS_PASSWORD=

# FFPC (myffpc.com) login
FFPC_USERNAME=
FFPC_PASSWORD=

# Port the backend listens on
PORT=3000
